JAVA_VERSION=21.0.11+10
JAVA_MAJOR_VERSION=21
GRADLE_VERSION=9.6.1
ANDROID_COMPILE_SDK=37
ANDROID_PLATFORM_VERSION=37.0
ANDROID_PLATFORM_ARCHIVE=platform-37.0_r02.zip
ANDROID_PLATFORM_SHA256=840b23e827f96e64aea4c89a1194aac3dc5f6bad37edb231c5c795d890330e8d
ANDROID_SDK_LICENSE_SHA1=24333f8a63b6825ea9c5514f83c2829b004d1fee
ANDROID_PLATFORM_TOOLS_VERSION=37.0.0
ANDROID_PLATFORM_TOOLS_ARCHIVE=platform-tools_r37.0.0-linux.zip
ANDROID_PLATFORM_TOOLS_SHA256=198ae156ab285fa555987219af237b31102fefe8b9d2bc274708a8d4f2865a07
ANDROID_BUILD_TOOLS_VERSION=37.0.0
ANDROID_BUILD_TOOLS_ARCHIVE=build-tools_r37_linux.zip
ANDROID_BUILD_TOOLS_SHA256=01af179347cbcd9c208b7f8171f7b21f6dd1d2f85bcd15e88caa51d5d7b86060
# The generated Flutter module sets `ndkVersion = flutter.ndkVersion`, so AGP
# resolves this exact side-by-side NDK while configuring :flutter. The version
# is dictated by the pinned Flutter release (FlutterExtension.ndkVersion).
# SHA-256 computed from the archive whose SHA-1 matches Google's
# repository2-3.xml entry for ndk;28.2.13676358.
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_NDK_ARCHIVE=android-ndk-r28c-linux.zip
ANDROID_NDK_ARCHIVE_ROOT=android-ndk-r28c
ANDROID_NDK_SHA256=dfb20d396df28ca02a8c708314b814a4d961dc9074f9a161932746f815aa552f
# The `jni` Dart package compiles native code, and AGP resolves its own default
# CMake for that. The version is AGP's, not this repository's. Without it the
# release build fails at :jni:configureCMakeRelWithDebInfo and
# :flutter:configureCMakeRelease with "The SDK directory is not writable".
# The package ships bin/ninja too, so no separate generator is needed.
# SHA-256 computed from the archive whose SHA-1 and size match Google's
# repository2-3.xml entry for cmake;3.22.1.
ANDROID_CMAKE_VERSION=3.22.1
ANDROID_CMAKE_ARCHIVE=cmake-3.22.1-linux.zip
ANDROID_CMAKE_SHA256=9196644852a978012caf7a4067ba1898debf6cc204c3341562771e31080d6869
# Flutter is pinned as hard as the JDK: app/gradle.lockfile locks eight
# io.flutter:*:1.0.0-<engine revision> entries under STRICT dependency locking,
# so a different Flutter release changes the engine revision and fails the lock.
FLUTTER_VERSION=3.41.4
FLUTTER_CHANNEL=stable
FLUTTER_FRAMEWORK_REVISION=ff37bef603469fb030f2b72995ab929ccfc227f0
FLUTTER_ENGINE_REVISION=e4b8dca3f1b4ede4c30371002441c88c12187ed6
FLUTTER_ENGINE_CONTENT_HASH=99578ad0355da00edb26301c874a3c250a5716f5
FLUTTER_DART_SDK_VERSION=3.11.1
FLUTTER_ARCHIVE=stable/linux/flutter_linux_3.41.4-stable.tar.xz
FLUTTER_SHA256=c9c4e741ebcf83ee88303404176f7e22c3b6abfc8e9d60781098b6d4104327a9
FLUTTER_SDK_DIR=/opt/flutter
PUB_CACHE_DIR=/opt/pub-cache
