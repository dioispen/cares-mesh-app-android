rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified Rescuer（經過額外認證的救援者，見 CONTEXT.md）的唯一依據：
    // rescuers/{uid} 文件存在與否。一般 Rescuer 不需要認證，任何人都能接互助任務；
    // 只有讀取 Sensitive Tier 需要這個身分（ADR-0005）。
    //
    // 刻意不放在 users/{uid} 的 role 欄位——使用者本來就能寫自己的 users 文件，
    // 把角色放在那裡等於讓人自我提權。rescuers 對客戶端一律唯讀，只能由後台
    // （Firebase console 或 Admin SDK）授予與撤銷。
    function isRescuer() {
      return request.auth != null
          && exists(/databases/$(database)/documents/rescuers/$(request.auth.uid));
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isOwner(userId) {
      return request.auth != null && userId == request.auth.uid;
    }

    // 健康回報的狀況調查：依 ADR-0007 拆在兩份文件（Detail Tier 的 survey、Sensitive Tier
    // 的 surveySensitive）。只檢查最外層的 keys() 擋不到巢狀 map 裡的內容，所以這兩個欄位
    // 自己也要用 hasOnly() 鎖住，敏感項目才不會誤寫進大家都讀得到的 Detail Tier。
    // 欄位可以不存在或為 null（沒有填調查）。
    function mapFieldHasOnly(data, field, allowed) {
      return !(field in data)
          || data[field] == null
          || (data[field] is map && data[field].keys().hasOnly(allowed));
    }
    function detailSurveyKeys() {
      return ['mobility', 'location', 'companions', 'housing', 'needs'];
    }
    function sensitiveSurveyKeys() {
      return ['vulnerable', 'notes'];
    }

    match /rescuers/{uid} {
      // 只能查自己是不是 Verified Rescuer；名單本身不外流。
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // health_reports：Health Report 的 Detail Tier（ADR-0005）——姓名、居住區域、Status 與
    // 傷勢細項、精確座標、回報時間、SOS（ADR-0004：SOS 是 Health Report 上的標記，不另開
    // collection），以及互助任務的 taskStatus／helperId。文件 ID 是 Reporter 的 uid，一人一份。
    //
    // 任何登入帳號都能讀：互助任務要讓附近的人知道誰需要幫忙、在哪裡，才能趕過去。
    // 這是刻意的決定（ADR-0005），取代 issue #33 對這份文件「只給本人與救援者」的限制。
    // 電話、血型、病史、緊急聯絡人屬於 Sensitive Tier，放在 health_report_sensitive；
    // 這裡的 create／update 用 keys().hasOnly() 擋住，不能誤寫進大家都讀得到的文件。
    match /health_reports/{docId} {
      // 任務狀態欄位缺席時一律視為「等待中／無人認領」，讓規則能相容
      // 還沒有 taskStatus 的文件。
      function curStatus() { return resource.data.get('taskStatus', 'waiting'); }
      function newStatus() { return request.resource.data.get('taskStatus', 'waiting'); }
      function curHelper() { return resource.data.get('helperId', null); }
      function newHelper() { return request.resource.data.get('helperId', null); }
      function detailTierKeys() {
        return ['id', 'reporterId', 'name', 'area', 'status', 'description',
                'lat', 'lng', 'reportTime', 'sos', 'taskStatus', 'helperId', 'survey'];
      }
      function sosIsBool() { return request.resource.data.get('sos', false) is bool; }

      allow read: if request.auth != null;
      // 一人一筆：文件 ID 必須是自己的 uid。只檢查 reporterId 的話，任何人都能先建立
      // health_reports/{別人的 uid}，讓對方之後的 set() 變成「改別人的文件」而一直被擋。
      // 舊版 App 用 add() 產生隨機 ID，會因此無法再新增回報。
      allow create: if request.auth != null
                    && docId == request.auth.uid
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(detailTierKeys())
                    && sosIsBool()
                    && mapFieldHasOnly(request.resource.data, 'survey', detailSurveyKeys());
      // update 不得改動 reporterId：轉手給他人等於把這份回報和它的 Sensitive Tier
      // 讀取權交給對方。
      allow update: if request.auth != null
                    && resource.data.reporterId == request.auth.uid
                    && request.resource.data.reporterId == resource.data.reporterId
                    && request.resource.data.keys().hasOnly(detailTierKeys())
                    && sosIsBool()
                    && mapFieldHasOnly(request.resource.data, 'survey', detailSurveyKeys());
      allow delete: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;

      // 互助任務狀態：協助者不是回報者，卻必須能改動「別人的文件」才能認領任務。
      //
      // 這裡不能放寬成整份文件可寫——姓名、傷勢、座標都在同一份文件裡。
      // 因此比照 supply_items 的 pledgedQty 做欄位層級限制：只開放 taskStatus 與
      // helperId 兩個欄位，其餘一律不可竄改。
      //
      // 狀態機同時擋掉三種搗亂：搶走別人已認領的任務、冒名把 helperId 填成第三人、
      // 把任務從「已完成」翻回去。認領不需要救援者認證；沒認證的協助者一樣能接任務，
      // 只是讀不到 Sensitive Tier。
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['taskStatus', 'helperId'])
                    && (
                         // 認領：等待中 → 已接受，且只能把自己填為協助者
                         (curStatus() == 'waiting'
                          && newStatus() == 'accepted'
                          && newHelper() == request.auth.uid)
                         // 完成：已接受 → 已完成，限當初認領的本人
                         || (curStatus() == 'accepted'
                             && newStatus() == 'done'
                             && curHelper() == request.auth.uid
                             && newHelper() == request.auth.uid)
                         // 放棄：已接受 → 等待中，限本人，並且要把 helperId 清掉
                         || (curStatus() == 'accepted'
                             && newStatus() == 'waiting'
                             && curHelper() == request.auth.uid
                             && newHelper() == null)
                       );
    }

    // health_report_sensitive：Health Report 的 Sensitive Tier（ADR-0005）——電話、血型、
    // 病史、緊急聯絡人。文件 ID 是 Reporter 的 uid，與 health_reports/{uid} 一對一。
    //
    // 只有兩種人讀得到：
    //   1. Reporter 本人。
    //   2. 經過認證的救援者（rescuers 名單，只能由後台授予），而且此刻正接著這位
    //      Reporter 的互助任務：health_reports/{uid} 的 taskStatus 是 accepted、
    //      helperId 是自己。放棄或完成任務之後就讀不到了。
    // NOTE: 規則只能擋之後的讀取，已經讀到協助者手機上的內容收不回來。
    match /health_report_sensitive/{uid} {
      function task() {
        return get(/databases/$(database)/documents/health_reports/$(uid)).data;
      }

      allow read: if request.auth != null
                  && (uid == request.auth.uid
                      || (isRescuer()
                          && task().get('taskStatus', 'waiting') == 'accepted'
                          && task().get('helperId', null) == request.auth.uid));
      allow create, update: if request.auth != null
                            && uid == request.auth.uid
                            && request.resource.data.reporterId == request.auth.uid
                            && request.resource.data.keys().hasOnly(
                                 ['reporterId', 'phone', 'bloodType', 'medicalInfo',
                                  'emergencyContactName', 'emergencyContactPhone',
                                  'emergencyContactRelation', 'surveySensitive'])
                            && mapFieldHasOnly(request.resource.data, 'surveySensitive',
                                               sensitiveSurveyKeys());
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    // sos_requests：已停用（#83）。SOS 改為 health_reports 的 sos 欄位（ADR-0004）。
    //
    // 舊資料含姓名、電話、血型、病史與精確座標，以前任何登入帳號都讀得到（#64）。資料還在，
    // 所以讀取收緊為只有本人：依 ADR-0005，電話與病史只給正在協助這位 Reporter 的 Verified
    // Rescuer，而舊資料沒有任務可以對應，連 Verified Rescuer 也不開放（#83 原本寫「本人與救援者」）。
    // 不能再新建，本人仍可整理或刪除自己的舊資料。
    match /sos_requests/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // users: 個人檔案含電話、緊急聯絡人、血型、病史等 PII（models/user.dart），
    // 只能讀寫自己的文件。客戶端也只讀自己的（login / setup 流程）。
    // NOTE: 這裡的任何欄位（例如 role）都不構成授權依據，救援者身分見 rescuers。
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // supply_items 是所有使用者共用的型錄；套用欄位限制而非擁有者限制，
    // 讓使用者能在任何物資上登記需求或捐贈，但不能竄改描述欄位。
    match /supply_items/{docId} {
      allow read: if request.auth != null;

      // 客戶端在型錄為空時寫入固定種子；不可藉由種子資料偽造需求或捐贈總量。
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['name', 'unit', 'category', 'inventoryQty',
                          'totalRequestedQty', 'totalPledgedQty'])
                    && request.resource.data.keys().hasAll(
                         ['name', 'unit', 'category', 'inventoryQty',
                          'totalRequestedQty', 'totalPledgedQty'])
                    && request.resource.data.name is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && isNonNegativeInt(request.resource.data.inventoryQty)
                    && request.resource.data.totalRequestedQty == 0
                    && request.resource.data.totalPledgedQty == 0;

      // 需求／捐贈登記會以 increment 更新共用計數；其餘欄位及負數計數不可寫入。
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(
                           ['inventoryQty', 'totalRequestedQty', 'totalPledgedQty'])
                    && isNonNegativeInt(request.resource.data.inventoryQty)
                    && isNonNegativeInt(request.resource.data.totalRequestedQty)
                    && isNonNegativeInt(request.resource.data.totalPledgedQty);

      allow delete: if false;
    }

    // 申請與捐贈紀錄含有個人識別資料；使用者只能讀寫自己的紀錄。
    match /supply_requests/{requestId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'createdAt'])
                    && request.resource.data.userName is string
                    && request.resource.data.itemId is string
                    && request.resource.data.itemName is string
                    && request.resource.data.unit is string
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;

      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['quantity', 'status', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName', 'unit',
                          'quantity', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.status in
                         ['pending', 'fulfilled', 'cancelled'];

      allow delete: if isOwner(resource.data.userId);
    }

    match /supply_pledges/{pledgeId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'qty', 'status', 'pledgedAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'qty', 'status', 'pledgedAt'])
                    && request.resource.data.userName is string
                    && request.resource.data.itemId is string
                    && request.resource.data.itemName is string
                    && request.resource.data.unit is string
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.status == 'pledged'
                    && request.resource.data.pledgedAt is timestamp;

      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['qty', 'status', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName', 'unit',
                          'qty', 'status', 'pledgedAt', 'updatedAt'])
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.status in
                         ['pledged', 'delivered', 'cancelled'];

      allow delete: if isOwner(resource.data.userId);
    }

    // 舊版 pledges 路徑保留既有擁有者保護，避免影響尚未遷移的資料。
    match /pledges/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'pledgedAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'itemId', 'quantity', 'status'])
                    && request.resource.data.itemId is string
                    && request.resource.data.status is string
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0;

      // 只有擁有者能改自己的認領，且不得把文件「轉手」給別人或換成別的物資。
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
