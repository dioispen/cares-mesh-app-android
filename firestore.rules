rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Verified Rescuer（經過額外認證的救援者，見 CONTEXT.md）的唯一依據：
    // rescuers/{uid} 文件存在與否。一般 Rescuer 不需要認證，任何人都能接互助任務；
    // 只有讀取 Sensitive Tier 需要這個身分（ADR-0005）。
    //
    // 刻意不放在 users/{uid} 的 role 欄位——使用者本來就能寫自己的 users 文件，
    // 把角色放在那裡等於讓人自我提權。rescuers 對客戶端一律唯讀，只能由後台
    // （Firebase console 或 Admin SDK）授予與撤銷。
    function isRescuer() {
      return request.auth != null
          && exists(/databases/$(database)/documents/rescuers/$(request.auth.uid));
    }

    // Administrator（管理後台的帳號，見 CONTEXT.md 與 docs/MESH_GATEWAY.md）的唯一依據：
    // admins/{uid} 文件存在與否。只有 Administrator 讀得到 Gateway 代傳的 mesh_reports，
    // 以及 Reporter Handle 屬於哪個帳號（reporter_handles，ADR-0009）。
    //
    // 授予方式：由專案管理者在 Firebase console（或用 Admin SDK）建立 admins/{該帳號的 uid}，
    // 內容不限，空文件也可以；刪掉那份文件就是撤銷。
    //
    // 與 Verified Rescuer 互相獨立：rescuers 與 admins 是兩份名單，持有其中一個不會得到
    // 另一個的任何權限——Administrator 讀不到 Sensitive Tier，Verified Rescuer 也讀不到
    // Gateway 的資料。和 isRescuer() 一樣不放在 users/{uid} 的欄位，因為使用者能寫自己的
    // users 文件，放在那裡等於讓人自我提權。
    function isAdmin() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isNonNegativeInt(value) {
      return value is int && value >= 0;
    }

    function isOwner(userId) {
      return request.auth != null && userId == request.auth.uid;
    }

    // 健康回報的狀況調查：依 ADR-0007 拆在兩份文件（Detail Tier 的 survey、Sensitive Tier
    // 的 surveySensitive）。只檢查最外層的 keys() 擋不到巢狀 map 裡的內容，所以這兩個欄位
    // 自己也要用 hasOnly() 鎖住，敏感項目才不會誤寫進大家都讀得到的 Detail Tier。
    // 欄位可以不存在或為 null（沒有填調查）。
    function mapFieldHasOnly(data, field, allowed) {
      return !(field in data)
          || data[field] == null
          || (data[field] is map && data[field].keys().hasOnly(allowed));
    }
    function detailSurveyKeys() {
      return ['mobility', 'location', 'companions', 'housing', 'needs'];
    }
    function sensitiveSurveyKeys() {
      return ['vulnerable', 'selfVulnerable', 'notes'];
    }

    match /rescuers/{uid} {
      // 只能查自己是不是 Verified Rescuer；名單本身不外流。
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /admins/{uid} {
      // 比照 rescuers：只能查自己是不是 Administrator，名單不外流。客戶端一律不可寫，
      // 連 Administrator 自己也不能替別人授權或撤銷自己，只能由後台處理。
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // health_reports：Health Report 的 Detail Tier（ADR-0005）——姓名、居住區域、Status 與
    // 傷勢細項、精確座標、回報時間、SOS（ADR-0004：SOS 是 Health Report 上的標記，不另開
    // collection），以及互助任務的 taskStatus／helperId。文件 ID 是 Reporter 的 uid，一人一份。
    //
    // 任何登入帳號都能讀：互助任務要讓附近的人知道誰需要幫忙、在哪裡，才能趕過去。
    // 這是刻意的決定（ADR-0005），取代 issue #33 對這份文件「只給本人與救援者」的限制。
    // 電話、血型、病史、緊急聯絡人屬於 Sensitive Tier，放在 health_report_sensitive；
    // 這裡的 create／update 用 keys().hasOnly() 擋住，不能誤寫進大家都讀得到的文件。
    match /health_reports/{docId} {
      // 任務狀態欄位缺席時一律視為「等待中／無人認領」，讓規則能相容
      // 還沒有 taskStatus 的文件。
      function curStatus() { return resource.data.get('taskStatus', 'waiting'); }
      function newStatus() { return request.resource.data.get('taskStatus', 'waiting'); }
      function curHelper() { return resource.data.get('helperId', null); }
      function newHelper() { return request.resource.data.get('helperId', null); }
      function detailTierKeys() {
        return ['id', 'reporterId', 'name', 'area', 'status', 'description',
                'lat', 'lng', 'reportTime', 'sos', 'taskStatus', 'helperId', 'survey'];
      }
      function sosIsBool() { return request.resource.data.get('sos', false) is bool; }

      allow read: if request.auth != null;
      // 一人一筆：文件 ID 必須是自己的 uid。只檢查 reporterId 的話，任何人都能先建立
      // health_reports/{別人的 uid}，讓對方之後的 set() 變成「改別人的文件」而一直被擋。
      // 舊版 App 用 add() 產生隨機 ID，會因此無法再新增回報。
      allow create: if request.auth != null
                    && docId == request.auth.uid
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.keys().hasOnly(detailTierKeys())
                    && sosIsBool()
                    && mapFieldHasOnly(request.resource.data, 'survey', detailSurveyKeys());
      // update 不得改動 reporterId：轉手給他人等於把這份回報和它的 Sensitive Tier
      // 讀取權交給對方。
      allow update: if request.auth != null
                    && resource.data.reporterId == request.auth.uid
                    && request.resource.data.reporterId == resource.data.reporterId
                    && request.resource.data.keys().hasOnly(detailTierKeys())
                    && sosIsBool()
                    && mapFieldHasOnly(request.resource.data, 'survey', detailSurveyKeys());
      allow delete: if request.auth != null
                    && resource.data.reporterId == request.auth.uid;

      // 互助任務狀態：協助者不是回報者，卻必須能改動「別人的文件」才能認領任務。
      //
      // 這裡不能放寬成整份文件可寫——姓名、傷勢、座標都在同一份文件裡。
      // 因此比照 supply_items 的 pledgedQty 做欄位層級限制：只開放 taskStatus 與
      // helperId 兩個欄位，其餘一律不可竄改。
      //
      // 狀態機同時擋掉三種搗亂：搶走別人已認領的任務、冒名把 helperId 填成第三人、
      // 把任務從「已完成」翻回去。認領不需要救援者認證；沒認證的協助者一樣能接任務，
      // 只是讀不到 Sensitive Tier。
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['taskStatus', 'helperId'])
                    && (
                         // 認領：等待中 → 已接受，且只能把自己填為協助者
                         (curStatus() == 'waiting'
                          && newStatus() == 'accepted'
                          && newHelper() == request.auth.uid)
                         // 完成：已接受 → 已完成，限當初認領的本人
                         || (curStatus() == 'accepted'
                             && newStatus() == 'done'
                             && curHelper() == request.auth.uid
                             && newHelper() == request.auth.uid)
                         // 放棄：已接受 → 等待中，限本人，並且要把 helperId 清掉
                         || (curStatus() == 'accepted'
                             && newStatus() == 'waiting'
                             && curHelper() == request.auth.uid
                             && newHelper() == null)
                       );
    }

    // health_report_sensitive：Health Report 的 Sensitive Tier（ADR-0005）——電話、血型、
    // 病史、緊急聯絡人。文件 ID 是 Reporter 的 uid，與 health_reports/{uid} 一對一。
    //
    // 只有兩種人讀得到：
    //   1. Reporter 本人。
    //   2. 經過認證的救援者（rescuers 名單，只能由後台授予），而且此刻正接著這位
    //      Reporter 的互助任務：health_reports/{uid} 的 taskStatus 是 accepted、
    //      helperId 是自己。放棄或完成任務之後就讀不到了。
    // NOTE: 規則只能擋之後的讀取，已經讀到協助者手機上的內容收不回來。
    match /health_report_sensitive/{uid} {
      function task() {
        return get(/databases/$(database)/documents/health_reports/$(uid)).data;
      }

      allow read: if request.auth != null
                  && (uid == request.auth.uid
                      || (isRescuer()
                          && task().get('taskStatus', 'waiting') == 'accepted'
                          && task().get('helperId', null) == request.auth.uid));
      allow create, update: if request.auth != null
                            && uid == request.auth.uid
                            && request.resource.data.reporterId == request.auth.uid
                            && request.resource.data.keys().hasOnly(
                                 ['reporterId', 'phone', 'bloodType', 'medicalInfo',
                                  'emergencyContactName', 'emergencyContactPhone',
                                  'emergencyContactRelation', 'surveySensitive'])
                            && mapFieldHasOnly(request.resource.data, 'surveySensitive',
                                               sensitiveSurveyKeys());
      allow delete: if request.auth != null && uid == request.auth.uid;
    }

    // sos_requests：已停用（#83）。SOS 改為 health_reports 的 sos 欄位（ADR-0004）。
    //
    // 舊資料含姓名、電話、血型、病史與精確座標，以前任何登入帳號都讀得到（#64）。資料還在，
    // 所以讀取收緊為只有本人：依 ADR-0005，電話與病史只給正在協助這位 Reporter 的 Verified
    // Rescuer，而舊資料沒有任務可以對應，連 Verified Rescuer 也不開放（#83 原本寫「本人與救援者」）。
    // 不能再新建，本人仍可整理或刪除自己的舊資料。
    match /sos_requests/{docId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // users: 個人檔案含電話、緊急聯絡人、血型、病史等 PII（models/user.dart），
    // 只能讀寫自己的文件。客戶端也只讀自己的（login / setup 流程）。
    // NOTE: 這裡的任何欄位（例如 role）都不構成授權依據，救援者身分見 rescuers。
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // reporter_handles/{uid}/installations/{reporterHandle}：Reporter 本人登記「這次安裝的
    // Reporter Handle 屬於我」（docs/MESH_GATEWAY.md 5.3），讓管理後台能把 Gateway 代傳的
    // mesh_reports 對回已註冊的帳號，並與 health_reports 去重。一個帳號用幾支手機就有幾份；
    // 一支手機先後登入不同帳號時，同一個 Handle 會出現在多個 uid 底下，所以不擋重複的 Handle。
    //
    // 只有 Administrator 與本人讀得到（ADR-0009）：Reporter Handle 在 mesh 上是明文，
    // 附近任何人都聽得到；要是登入帳號就能查，等於讓人憑空中聽到的 Handle 查出是誰。
    //
    // 只有本人能寫，而且只能寫在自己的 uid 底下——寫在別人底下等於替別人認領 Handle。
    // 但這擋不住把「聽到的別人的 Handle」登記在自己底下（冒領）：規則不知道 Handle 背後是
    // 哪一把 key。後台遇到多個 uid 宣稱同一個 Handle 時，比對 signingPublicKey 與
    // mesh_reports 原始封包的簽章 key 才分得出來（docs/MESH_GATEWAY.md 第 9 節）。
    // Administrator 可以刪（清理冒領或災後清空），但不能替人登記。
    match /reporter_handles/{uid}/installations/{handle} {
      function validInstallation(handle) {
        let data = request.resource.data;
        let fields = ['reporterHandle', 'signingPublicKey', 'registeredAt'];
        return data.keys().hasAll(fields)
            && data.keys().hasOnly(fields)
            // 文件 ID 就是 Handle；小寫 12 碼十六進位，與 mesh_reports 的文件 ID 一致，
            // 後台才能直接拿來對照。
            && handle.matches('^[0-9a-f]{12}$')
            && handle == data.reporterHandle
            // ANNOUNCE 裡的那把 Ed25519 簽章公鑰，固定 32 bytes。
            && data.signingPublicKey is bytes
            && data.signingPublicKey.size() == 32
            // 用伺服器時間：後台以最新的 registeredAt 判斷 Handle 目前屬於哪個帳號，
            // 不能讓客戶端填未來的時間搶先。
            && data.registeredAt == request.time;
      }

      allow read: if isAdmin() || isOwner(uid);
      // create 與 update 同一套檢查：App 每次啟動都會整份覆寫一次（idempotent 登記）。
      allow create, update: if isOwner(uid) && validInstallation(handle);
      allow delete: if isAdmin() || isOwner(uid);
    }

    // 管理後台用 collection group 查詢 installations（where reporterHandle == handle），從
    // 結果的路徑取出 uid（docs/MESH_GATEWAY.md 第 8 節）。collection group 查詢只認遞迴
    // 萬用字元的 match，上面 /reporter_handles/{uid}/installations/{handle} 的規則套用不到，
    // 所以另外開這一條給 Administrator。
    //
    // 規則是「任一條 allow 成立即可」，所以這條對 reporter_handles 底下的文件只會多放行
    // Administrator，而 Administrator 本來就讀得到；其他人沒有新增任何讀取權。
    // NOTE: 它也涵蓋任何路徑下名為 installations 的 collection，別的資料不要取這個名字，
    // 否則 Administrator 也讀得到。
    match /{path=**}/installations/{handle} {
      allow read: if isAdmin();
    }

    // mesh_reports/{reporterHandle}：Gateway 代傳上來的 Health Report Broadcast Tier
    // （docs/MESH_GATEWAY.md 5.2、ADR-0009）。每個 Reporter Handle 一份，只保留 reportTime
    // 最新的那份。內容只有 Status、SOS、geohash-6 與稽核材料，沒有 Detail／Sensitive Tier。
    //
    // 只有 Administrator 能讀、能刪：這是給管理後台統計的資料，寫入的 Gateway 自己也讀不到
    // （它本來就不先讀再寫）。App 不刪除任何 mesh_reports，災後由 Administrator 清空。
    //
    // 任何登入帳號都可能是 Gateway，所以任何登入帳號都能寫。伺服器端不驗簽（沒有 Cloud
    // Functions），規則看不出內容是不是 Reporter 真的發的：偽造 SOS、用「安全」蓋掉真的 SOS
    // 都擋不住（docs/MESH_GATEWAY.md 第 9 節）。規則能做的是：
    //   - 格式：欄位、型別、Status 與 SOS 的合法組合都要對，後台不必處理垃圾資料。
    //   - 稽核：gatewayUid 必須是寫入者自己，出事時能追到是哪個帳號寫的。
    //   - 時間：reportTime 的範圍與 update 的嚴格遞增，見下方說明。
    match /mesh_reports/{handle} {
      function validMeshReport(handle) {
        let data = request.resource.data;
        let fields = ['schemaVersion', 'reporterHandle', 'status', 'sos', 'geohash',
                      'reportTime', 'uploadedAt', 'gatewayUid', 'senderPeerId',
                      'rawPacket', 'announcement'];
        return request.auth != null
            && data.gatewayUid == request.auth.uid
            // 欄位一個都不能少：geohash 與 announcement 沒有值時也要明確寫 null。
            && data.keys().hasAll(fields)
            && data.keys().hasOnly(fields)
            && data.schemaVersion is int
            && data.schemaVersion == 1
            // 文件 ID 就是 Handle，與 reporter_handles 的文件 ID 同一種格式，後台才能對照。
            && handle.matches('^[0-9a-f]{12}$')
            && handle == data.reporterHandle
            && data.status in ['安全', '輕傷', '重傷', '未宣告']
            && data.sos is bool
            // ADR-0004：宣告「安全」就是撤回 SOS；「未宣告」只會出現在舉起 SOS 而沒說
            // 傷勢的時候。
            && !(data.status == '安全' && data.sos)
            && !(data.status == '未宣告' && !data.sos)
            // ADR-0008：Broadcast Tier 的 geohash 精度是 6；Reporter 沒有位置時為 null。
            && (data.geohash == null || (data.geohash is string && data.geohash.size() == 6))
            && data.uploadedAt == request.time
            // reportTime 是 Reporter 手機的時鐘，精度到秒。往後最多容忍 10 分鐘的時鐘誤差：
            // 再晚的話，一份未來時間的回報會讓之後真的回報都不夠「新」，把文件鎖死。
            // 往前最多 2 小時 10 分鐘：Gateway 只轉送 2 小時內的回報，再舊的已過保留期限。
            && data.reportTime is timestamp
            && data.reportTime <= request.time + duration.value(10, 'm')
            && data.reportTime >= request.time - duration.value(130, 'm')
            // 封包標頭的 senderID：8 bytes，16 個小寫十六進位字元。
            && data.senderPeerId is string
            && data.senderPeerId.matches('^[0-9a-f]{16}$')
            // 日後驗簽的材料，現在沒有人驗。正常的 HEALTH_REPORT 與 ANNOUNCE 編碼（含
            // padding）都在 1 KB 以內；設上限是不讓這兩個欄位被拿來塞大檔案。
            && data.rawPacket is bytes
            && data.rawPacket.size() <= 1024
            && (data.announcement == null
                || (data.announcement is bytes && data.announcement.size() <= 1024));
      }

      allow read, delete: if isAdmin();
      allow create: if validMeshReport(handle);
      // update 要求 reportTime 嚴格遞增：Gateway 不先讀再寫，慢一步的 Gateway 拿著較舊的
      // 回報整份覆寫時，會被這條擋下，不會蓋掉別的 Gateway 已經寫入的較新回報（Gateway
      // 把 PERMISSION_DENIED 當成「已經有人寫過」）。換哪一支 Gateway 寫都可以，gatewayUid
      // 會換成新的寫入者。代價是同一秒內送出的第二份回報會被拒；極少見，接受。
      allow update: if validMeshReport(handle)
                    && request.resource.data.reportTime > resource.data.reportTime;
    }

    // supply_items 是所有使用者共用的型錄；套用欄位限制而非擁有者限制，
    // 讓使用者能在任何物資上登記需求或捐贈，但不能竄改描述欄位。
    match /supply_items/{docId} {
      allow read: if request.auth != null;

      // 客戶端在型錄為空時寫入固定種子；不可藉由種子資料偽造需求或捐贈總量。
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['name', 'unit', 'category', 'inventoryQty',
                          'totalRequestedQty', 'totalPledgedQty'])
                    && request.resource.data.keys().hasAll(
                         ['name', 'unit', 'category', 'inventoryQty',
                          'totalRequestedQty', 'totalPledgedQty'])
                    && request.resource.data.name is string
                    && request.resource.data.unit is string
                    && request.resource.data.category is string
                    && isNonNegativeInt(request.resource.data.inventoryQty)
                    && request.resource.data.totalRequestedQty == 0
                    && request.resource.data.totalPledgedQty == 0;

      // 需求／捐贈登記會以 increment 更新共用計數；其餘欄位及負數計數不可寫入。
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(
                           ['inventoryQty', 'totalRequestedQty', 'totalPledgedQty'])
                    && isNonNegativeInt(request.resource.data.inventoryQty)
                    && isNonNegativeInt(request.resource.data.totalRequestedQty)
                    && isNonNegativeInt(request.resource.data.totalPledgedQty);

      allow delete: if false;
    }

    // 申請與捐贈紀錄含有個人識別資料；使用者只能讀寫自己的紀錄。
    match /supply_requests/{requestId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'createdAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'createdAt'])
                    && request.resource.data.userName is string
                    && request.resource.data.itemId is string
                    && request.resource.data.itemName is string
                    && request.resource.data.unit is string
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp;

      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['quantity', 'status', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName', 'unit',
                          'quantity', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0
                    && request.resource.data.status in
                         ['pending', 'fulfilled', 'cancelled'];

      allow delete: if isOwner(resource.data.userId);
    }

    match /supply_pledges/{pledgeId} {
      allow read: if isOwner(resource.data.userId);

      allow create: if isOwner(request.resource.data.userId)
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'qty', 'status', 'pledgedAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'qty', 'status', 'pledgedAt'])
                    && request.resource.data.userName is string
                    && request.resource.data.itemId is string
                    && request.resource.data.itemName is string
                    && request.resource.data.unit is string
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.status == 'pledged'
                    && request.resource.data.pledgedAt is timestamp;

      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['qty', 'status', 'updatedAt'])
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName', 'unit',
                          'qty', 'status', 'pledgedAt', 'updatedAt'])
                    && request.resource.data.qty is int
                    && request.resource.data.qty > 0
                    && request.resource.data.status in
                         ['pledged', 'delivered', 'cancelled'];

      allow delete: if isOwner(resource.data.userId);
    }

    // 舊版 pledges 路徑保留既有擁有者保護，避免影響尚未遷移的資料。
    match /pledges/{docId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userName', 'itemId', 'itemName',
                          'unit', 'quantity', 'status', 'pledgedAt'])
                    && request.resource.data.keys().hasAll(
                         ['userId', 'itemId', 'quantity', 'status'])
                    && request.resource.data.itemId is string
                    && request.resource.data.status is string
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0;

      // 只有擁有者能改自己的認領，且不得把文件「轉手」給別人或換成別的物資。
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.itemId == resource.data.itemId
                    && request.resource.data.quantity is int
                    && request.resource.data.quantity > 0;

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid;
    }
  }
}
